# Консоль — только UART0. USB занят ролью Host, и вторичная консоль на
# USB-Serial-JTAG тоже отключена: логи не должны зависеть от USB вообще.
# На девките это второй порт платы (мост UART), на Supermini — внешний
# USB-UART.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Метки времени в логе — с микросекундной точностью (см. g920/log.h),
# поэтому время печатаем сами, а штатный префикс не используем.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_TIMESTAMP_SOURCE_RTOS=y

# 16 МБ — столько на обеих платах на руках (N16R8, проверено esptool).
# ⚠ Когда приедет Supermini, профилю tx-supermini понадобится 4 МБ.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ─── Задержка ────────────────────────────────────────────────────────────
# Замер: полный путь кадра через нашу логику — около 550 инструкций,
# ~2.3 мкс на 240 МГц. Односторонняя задержка ESP-NOW — 1000–2000 мкс.
# Всё, что ниже, влияет на порядки больше, чем любая правка этого кода.

# Тик планировщика. Значение по умолчанию — 100 Гц, то есть 10 мс
# гранулярности на любой vTaskDelay, таймаут и пробуждение задачи. Для
# линка, которому нужна реакция за 1–2 мс, это главный тормоз в системе.
CONFIG_FREERTOS_HZ=1000

# По умолчанию S3 стартует на 160 МГц. Всё, что считает CPU, ускоряется
# в полтора раза даром.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# По умолчанию сборка идёт с -Og. Для горячего пути это в полтора-два раза
# медленнее -O2. Проверки assert пока оставляем: веха ранняя.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Режим флеша. Реально его задаёт PlatformIO при заливке ключом
# --flash_mode из board_build.flash_mode (там уже qio) — esptool правит байт
# в заголовке образа. Эта строка нужна только чтобы sdkconfig не расходился
# с тем, чем на самом деле прошивают.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Главная задача качает такт линка, а он держит на стеке буфер надёжной
# очереди плюс собранный кадр. Умолчания 3584 байт для этого впритык.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# PSRAM: 8 МБ октальной памяти на N16R8. Нужна трассе обмена — писать
# трафик в UART в горячем пути нельзя, это доказано живым рулём: печать
# начинала управлять временем на шине. Октальный режим, а не четырёхбитный:
# у R8 память OPI, и QSPI её просто не увидит.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
