.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Генерируется PlatformIO из sdkconfig.defaults на каждой сборке.
# Правим только sdkconfig.defaults — он и коммитится.
firmware/*/sdkconfig.*
!firmware/*/sdkconfig.defaults

# Скачивается менеджером компонентов ESP-IDF по firmware/*/src/idf_component.yml.
# В репозитории ему не место: это 2069 чужих файлов, а версия и так прибита
# в dependencies.lock — он-то и коммитится.
firmware/*/managed_components/

# Официальный пакет документации GIP от Microsoft (aka.ms/gipdocs).
# Партнёрские документы, репозиторий публичный — выкладывать их здесь не наше
# дело. Лежат локально в docs/gip-official/; откуда взять — в PROGRESS.md.
docs/gip-official/
